---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Renaissance | Jingxuan Li">
    <main class="max-w-[700px] mx-auto px-8 py-12">
        
        <nav id="main-nav" class="flex gap-8 mb-12 text-[12px] uppercase tracking-[0.15em] text-zinc-400 font-medium overflow-x-auto whitespace-nowrap scrollbar-hide scroll-smooth">
            <a href="/" class="hover:text-black transition-all">Home</a>
            <a href="/visuals" class="hover:text-black transition-all">Visuals</a>
            <a href="/writing" class="hover:text-black transition-all">Writing</a>
            <a id="active-nav-item" href="/renaissance" class="text-black border-b border-black pb-1">Renaissance</a>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </nav>

        <header class="mb-10">
            <h1 class="text-3xl font-light tracking-tight mb-4 text-black">Renaissance</h1>
            <p class="text-[15px] font-light tracking-wide text-zinc-900 leading-snug italic max-w-prose mb-4">
                "A developing digital museum dedicated to the interconnected history, humanity, art, and science of the era."
            </p>
            <p class="text-zinc-500 leading-snug font-light text-[15px] max-w-prose">
                This space operates as an interactive map of time. Explore the historical figures driving the intellectual shift above, or trace their cross-disciplinary connections across the chronological network below.
            </p>
        </header>

        <div class="flex gap-8 mb-14 border-b border-zinc-100 pb-[10px] text-[13px] uppercase tracking-widest overflow-x-auto whitespace-nowrap scrollbar-hide">
            <button id="show-all" class="text-black font-bold border-b-2 border-black -mb-[10px] pb-2 transition-all shrink-0">Overview</button>
            <button id="show-analysis" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Analysis</button>
            <button id="show-reflections" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Reflections</button>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </div>

        <div id="content-container" class="space-y-16">
            
            <div id="overview-section" class="space-y-16">
                
                <section class="space-y-4">
                    <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-400 font-mono border-b border-zinc-200 pb-2">Polymaths & Masters</div>
                    
                    <div class="flex gap-8 overflow-x-auto py-6 px-2 scrollbar-hide">
                        <div class="shrink-0 w-[220px] bg-white border border-zinc-200 p-5 rounded shadow-xs hover:border-black transition-all duration-300 cursor-pointer map-node" data-id="dante" data-type="people">
                            <span class="text-[10px] font-mono text-zinc-400 block mb-1">1265 — 1321</span>
                            <h3 class="text-sm font-medium text-zinc-900">Dante Alighieri</h3>
                            <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The Supreme Poet. Laying the linguistic and visionary bedrock of the Renaissance.</p>
                            <span class="text-[9px] text-zinc-300 italic block mt-6">View Highlights →</span>
                        </div>

                        <div class="shrink-0 w-[220px] bg-white border border-zinc-200 p-5 rounded shadow-xs hover:border-black transition-all duration-300 cursor-pointer map-node" data-id="petrarch" data-type="people">
                            <span class="text-[10px] font-mono text-zinc-400 block mb-1">1304 — 1374</span>
                            <h3 class="text-sm font-medium text-zinc-900">Francesco Petrarca</h3>
                            <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The Father of Humanism. Recovering classical antiquity and human agency.</p>
                            <span class="text-[9px] text-zinc-300 italic block mt-6">View Highlights →</span>
                        </div>

                        <div class="shrink-0 w-[220px] bg-white border border-zinc-200 p-5 rounded shadow-xs hover:border-black transition-all duration-300 cursor-pointer map-node" data-id="boccaccio" data-type="people">
                            <span class="text-[10px] font-mono text-zinc-400 block mb-1">1313 — 1375</span>
                            <h3 class="text-sm font-medium text-zinc-900">Giovanni Boccaccio</h3>
                            <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">Author of Decameron. Realist prose capturing vibrant human textures.</p>
                            <span class="text-[9px] text-zinc-300 italic block mt-6">View Highlights →</span>
                        </div>

                        <div class="shrink-0 w-[220px] bg-white border border-zinc-200 p-5 rounded shadow-xs hover:border-black transition-all duration-300 cursor-pointer map-node" data-id="davinci" data-type="people">
                            <span class="text-[10px] font-mono text-zinc-400 block mb-1">1452 — 1519</span>
                            <h3 class="text-sm font-medium text-zinc-900">Leonardo da Vinci</h3>
                            <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The Ultimate Polymath. Unifying structural nature, machines, and fine arts.</p>
                            <span class="text-[9px] text-zinc-300 italic block mt-6">View Highlights →</span>
                        </div>
                    </div>
                </section>

                <section class="space-y-4">
                    <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-400 font-mono border-b border-zinc-200 pb-2">Space & Timeline Map</div>
                    
                    <div class="relative rounded border border-zinc-200 overflow-hidden bg-[#F4F1EA]">
                        
                        <div id="map-container" class="w-full h-[580px] overflow-x-auto overflow-y-hidden scrollbar-hide cursor-grab active:cursor-grabbing select-none relative">
                            
                            <div class="w-[1680px] h-full relative p-6 flex flex-col justify-between">
                                
                                <div class="w-full border-b border-zinc-300 pb-4 grid grid-cols-3 text-center sticky top-0 bg-[#F4F1EA] z-10 select-none pl-[100px]">
                                    <div class="border-r border-zinc-300/60 px-4 text-left">
                                        <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase I: Trecento (14th C.)</div>
                                        <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest">The Awakening / Philosophy & Literature</div>
                                    </div>
                                    <div class="border-r border-zinc-300/60 px-4 text-left">
                                        <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase II: Quattrocento & Cinquecento (15th-16th C.)</div>
                                        <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest">The Zenith / Fine Arts & Aesthetic Platonicism</div>
                                    </div>
                                    <div class="px-4 text-left">
                                        <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase III: Seicento (17th C.)</div>
                                        <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest">The Dawn of Science / Empirical Observation</div>
                                    </div>
                                </div>

                                <div class="flex-1 grid grid-rows-4 divide-y divide-zinc-300/40 py-4 select-none relative">
                                    
                                    <div class="relative flex items-center pl-[100px] h-full">
                                        <div class="absolute left-0 w-[80px] font-mono text-[10px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Thinkers</div>
                                        
                                        <div class="absolute left-[100px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="dante" data-type="people">Dante Alighieri</div>
                                        <div class="absolute left-[340px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="petrarch" data-type="people">Francesco Petrarca</div>
                                        <div class="absolute left-[1020px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="davinci" data-type="people">Leonardo da Vinci</div>
                                    </div>

                                    <div class="relative flex items-center pl-[100px] h-full">
                                        <div class="absolute left-0 w-[80px] font-mono text-[10px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Art</div>
                                        <div class="absolute left-[440px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="decameron_art" data-type="art">The Decameron Manuscript</div>
                                        <div class="absolute left-[1080px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="monalisa_art" data-type="art">Mona Lisa</div>
                                    </div>

                                    <div class="relative flex items-center pl-[100px] h-full">
                                        <div class="absolute left-0 w-[80px] font-mono text-[10px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Philosophy</div>
                                        <div class="absolute left-[380px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="humanism_philo" data-type="philosophy">Emergence of Humanism</div>
                                    </div>

                                    <div class="relative flex items-center pl-[100px] h-full">
                                        <div class="absolute left-0 w-[80px] font-mono text-[10px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Science</div>
                                        <div class="absolute left-[1280px] bg-white/80 border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="anatomy_science" data-type="science">Anatomical Dissections</div>
                                    </div>
                                </div>

                                <div class="w-full border-t border-zinc-300 pt-3 flex sticky bottom-0 bg-[#F4F1EA] z-10 select-none pl-[100px] font-mono text-[9px] text-zinc-400">
                                    <div class="flex-1 flex justify-between pr-4 border-r border-zinc-300/40">
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1250</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1300</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1350</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1400</span>
                                    </div>
                                    <div class="flex-1 flex justify-between px-4 border-r border-zinc-300/40">
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1450</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1500</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1550</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1600</span>
                                    </div>
                                    <div class="flex-1 flex justify-between pl-4">
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1650</span>
                                        <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1700</span>
                                        <span></span> </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div id="analysis-section" class="space-y-6" style="display: none;">
                <div class="text-[11px] uppercase tracking-[0.3em] text-zinc-900 font-bold border-b border-zinc-100 pb-2">Visual & Architectural Analysis</div>
                <p class="text-zinc-400 italic font-light text-[14px]">Renaissance-specific structural dissections and spatial analysis will be curated here.</p>
            </div>
            <div id="reflections-section" class="space-y-6" style="display: none;">
                <div class="text-[11px] uppercase tracking-[0.3em] text-zinc-900 font-bold border-b border-zinc-100 pb-2">Philosophical Reflections</div>
                <p class="text-zinc-400 italic font-light text-[14px]">Internal historical synchronicity papers and philosophical notes will be cataloged here.</p>
            </div>

        </div>

        <div id="master-modal" class="fixed inset-0 bg-black/20 backdrop-blur-xs z-50 hidden flex items-center justify-center p-6 transition-all duration-300">
            <div class="bg-white border border-zinc-200 w-full max-w-[460px] rounded shadow-2xl max-h-[85vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-300">
                <div class="p-5 border-b border-zinc-100 flex justify-between items-center bg-zinc-50/50">
                    <span id="modal-years" class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">Timeline</span>
                    <button id="close-modal" class="text-zinc-400 hover:text-black font-light text-xl transition-colors">&times;</button>
                </div>
                <div class="p-6 overflow-y-auto space-y-5 text-left scrollbar-hide">
                    <div>
                        <h2 id="modal-name" class="text-2xl font-light tracking-tight text-black">Name</h2>
                        <p id="modal-role" class="text-[11px] font-mono text-zinc-400 uppercase mt-1 tracking-wider">Role</p>
                    </div>
                    <div id="modal-artwork-container" class="hidden w-full overflow-hidden border border-zinc-100 rounded bg-zinc-50 shadow-xs">
                        <img id="modal-artwork-img" src="" alt="Artwork" class="w-full h-auto cursor-zoom-in hover:opacity-95 transition-opacity" />
                    </div>
                    <div class="space-y-2 bg-zinc-50 p-4 rounded border border-zinc-100">
                        <div id="modal-highlights" class="text-[13px] text-zinc-700 font-light leading-relaxed space-y-2"></div>
                    </div>
                    <div id="modal-essay-box" class="pt-4 border-t border-zinc-100 space-y-2 hidden">
                        <span class="text-[9px] uppercase tracking-widest text-zinc-400 font-mono block">My Philosophical Reflections</span>
                        <a id="modal-essay-link" href="#" class="inline-block text-[13px] text-black border-b border-black pb-0.5 hover:text-zinc-500 hover:border-zinc-300 transition-all font-light"></a>
                    </div>
                </div>
            </div>
        </div>

        <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden flex items-center justify-center p-4 cursor-zoom-out">
            <img id="lightbox-img" src="" class="max-w-full max-h-[90vh] object-contain rounded shadow-2xl" />
        </div>

        <footer class="mt-24 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
            L'Uomo Universale
        </footer>
    </main>
</Layout>

<script>
    // 主导航自动居中
    window.addEventListener('DOMContentLoaded', () => {
        const activeNav = document.getElementById('active-nav-item');
        const mainNav = document.getElementById('main-nav');
        if (activeNav && mainNav) {
            mainNav.scrollLeft = activeNav.offsetLeft - (mainNav.offsetWidth / 2) + (activeNav.offsetWidth / 2);
        }
    });

    // Sub Tab 切换
    const btnAll = document.getElementById('show-all');
    const btnAnalysis = document.getElementById('show-analysis');
    const btnReflections = document.getElementById('show-reflections');
    const overviewSec = document.getElementById('overview-section');
    const analysisSec = document.getElementById('analysis-section');
    const reflectionsSec = document.getElementById('reflections-section');

    function updateTabs(activeBtn) {
        [btnAll, btnAnalysis, btnReflections].forEach(btn => {
            if (btn) btn.classList.remove('text-black', 'font-bold', 'border-b-2', 'border-black', '-mb-[10px]', 'text-zinc-500');
            if (btn) btn.classList.add('text-zinc-500');
        });
        if (activeBtn) activeBtn.classList.add('text-black', 'font-bold', 'border-b-2', 'border-black', '-mb-[10px]');
    }
    if (btnAll) btnAll.addEventListener('click', () => { overviewSec.style.display = 'block'; analysisSec.style.display = 'none'; reflectionsSec.style.display = 'none'; updateTabs(btnAll); });
    if (btnAnalysis) btnAnalysis.addEventListener('click', () => { overviewSec.style.display = 'none'; analysisSec.style.display = 'block'; reflectionsSec.style.display = 'none'; updateTabs(btnAnalysis); });
    if (btnReflections) btnReflections.addEventListener('click', () => { overviewSec.style.display = 'none'; analysisSec.style.display = 'none'; reflectionsSec.style.display = 'block'; updateTabs(btnReflections); });

    // 一维纯横向物理拖动引擎（纵轴、上轴、下轴完美物理同步）
    const canvas = document.getElementById('map-container');
    if (canvas) {
        let isDown = false, startX, scrollLeft;
        canvas.addEventListener('mousedown', (e) => {
            isDown = true;
            canvas.classList.replace('cursor-grab', 'cursor-grabbing');
            startX = e.pageX - canvas.offsetLeft;
            scrollLeft = canvas.scrollLeft;
        });
        canvas.addEventListener('mouseleave', () => isDown = false);
        canvas.addEventListener('mouseup', () => { isDown = false; canvas.classList.replace('cursor-grabbing', 'cursor-grab'); });
        canvas.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            canvas.scrollLeft = scrollLeft - (e.pageX - startX) * 1.5;
        });
    }

    // 数据网格池
    const itemData = {
        'dante': { years: '1265 — 1321', name: 'Dante Alighieri', role: 'Poet / Philosopher / Theologian', type: 'people', highlights: '<p>• Synthesized medieval scholasticism with an intense, prophetic focus on human history and political agency.</p><p>• Elevated the Italian vernacular to a sublime literary language, rendering divine cosmic design accessible to mortal consciousness.</p>' },
        'petrarch': { years: '1304 — 1374', name: 'Francesco Petrarca', role: 'Humanist / Scholar / Lyric Poet', type: 'people', highlights: '<p>• Pioneered the recovery of Cicero and classical Latin texts, establishing the structural blueprint for humanistic education.</p><p>• Championed the concept of the intellectual life as a delicate balance between active civic duty and meditative introspection.</p>', essayTitle: 'Reflections on Petrarca\'s Secretum: The Inner Conflict', essayLink: '#' },
        'boccaccio': { years: '1313 — 1375', name: 'Giovanni Boccaccio', role: 'Novelist / Humanist Scholar', type: 'people', highlights: '<p>• Broke from rigid allegorical traditions to capture the untamed, complex, and psychological textures of everyday human existence.</p><p>• Created <button class="text-black underline font-medium cursor-pointer inline-modal-trigger" data-target="decameron_art">The Decameron Manuscript</button> as a prose monument.</p>' },
        'davinci': { years: '1452 — 1519', name: 'Leonardo da Vinci', role: 'Polymath / Painter / Structural Engineer', type: 'people', highlights: '<p>• Erased the false boundary between fine arts and mechanical logic, treating observation as a radical instrument of philosophical truth.</p><p>• Pioneered early optical science and structural geometry, applying them directly to his masterwork <button class="text-black underline font-medium cursor-pointer inline-modal-trigger" data-target="monalisa_art">Mona Lisa</button>.</p>', essayTitle: 'The Mechanical Eye: Deconstructing Da Vinci\'s Optics', essayLink: '#' },
        'decameron_art': { years: 'c. 1353', name: 'The Decameron Manuscript', role: 'Illuminated Prose / Manuscript / Library Artifact', type: 'art', highlights: '<p>A masterpiece of realism by <button class="text-black font-semibold border-b border-black cursor-pointer inline-modal-trigger" data-target="boccaccio">Giovanni Boccaccio</button>. It features 100 tales told by ten young people fleeing the Black Death outside Florence.</p>' },
        'monalisa_art': { years: 'c. 1503', name: 'Mona Lisa (La Gioconda)', role: 'Oil on Poplar Panel / Musée du Louvre', type: 'art', artwork: '/renaissance/mona_lisa.jpg', highlights: '<p>A testament to the visual science of <button class="text-black font-semibold border-b border-black cursor-pointer inline-modal-trigger" data-target="davinci">Leonardo da Vinci</button>. Built with dozens of microscopic layers of glazes (sfumato) to mirror the natural behavior of human vision, optics, and atmospheric depth.</p>' },
        'humanism_philo': { years: '14th — 15th Century', name: 'The Emergence of Humanism', role: 'Philosophical Paradigm Shift', type: 'philosophy', highlights: '<p>The revolutionary movement transition from medieval vertical geocentrism to Studia Humanitatis, heavily accelerated by <button class="text-black font-semibold border-b border-black cursor-pointer inline-modal-trigger" data-target="petrarch">Francesco Petrarca</button>.</p>' },
        'anatomy_science': { years: 'c. 1510', name: 'Anatomical Dissections', role: 'Empirical Methodology', type: 'science', highlights: '<p>The radical practice of anatomical inquiry led by <button class="text-black font-semibold border-b border-black cursor-pointer inline-modal-trigger" data-target="davinci">Leonardo da Vinci</button> in collaboration with Marcantonio della Torre.</p>' }
    };

    const modal = document.getElementById('master-modal');
    const mYears = document.getElementById('modal-years');
    const mName = document.getElementById('modal-name');
    const mRole = document.getElementById('modal-role');
    const mHighlights = document.getElementById('modal-highlights');
    const artContainer = document.getElementById('modal-artwork-container');
    const artImg = document.getElementById('modal-artwork-img') as HTMLImageElement;
    const essayBox = document.getElementById('modal-essay-box');
    const essayLink = document.getElementById('modal-essay-link');

    function openModal(id) {
        const data = itemData[id];
        if (!data) return;

        mYears.innerText = data.years; mName.innerText = data.name; mRole.innerText = data.role; mHighlights.innerHTML = data.highlights;

        if (data.type === 'art' && data.artwork) { artImg.src = data.artwork; artContainer?.classList.remove('hidden'); } 
        else { artContainer?.classList.add('hidden'); }

        if (data.essayTitle) {
            if (essayLink) { essayLink.innerText = `${data.essayTitle} →`; essayLink.setAttribute('href', data.essayLink); }
            essayBox?.classList.remove('hidden');
        } else { essayBox?.classList.add('hidden'); }

        setTimeout(() => {
            modal?.querySelectorAll('.inline-modal-trigger').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const targetNode = btn.getAttribute('data-target');
                    modal.querySelector('.bg-white')?.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => { openModal(targetNode); }, 150);
                });
            });
        }, 10);

        modal?.classList.remove('hidden');
        setTimeout(() => { modal?.querySelector('.bg-white')?.classList.remove('scale-95', 'opacity-0'); }, 20);
    }

    document.querySelectorAll('.map-node').forEach(node => {
        node.addEventListener('click', () => openModal(node.getAttribute('data-id')));
    });

    const closeModalBox = () => {
        modal?.querySelector('.bg-white')?.classList.add('scale-95', 'opacity-0');
        setTimeout(() => modal?.classList.add('hidden'), 150);
    };
    document.getElementById('close-modal')?.addEventListener('click', closeModalBox);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModalBox(); });

    // 灯箱
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    artImg?.addEventListener('click', () => { if (lightbox && lightboxImg) { lightboxImg.src = artImg.src; lightbox.classList.remove('hidden'); } });
    lightbox?.addEventListener('click', () => lightbox.classList.add('hidden'));
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>