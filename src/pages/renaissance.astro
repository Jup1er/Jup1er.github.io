---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Renaissance | Jingxuan Li">
    <main class="max-w-[700px] mx-auto px-8 py-12">
        
        <!-- 主导航栏（严格保持你原本的样式与字体） -->
        <nav class="flex gap-8 mb-12 text-[12px] uppercase tracking-[0.15em] text-zinc-400 font-medium overflow-x-auto whitespace-nowrap scrollbar-hide">
            <a href="/" class="hover:text-black transition-all">Home</a>
            <a href="/visuals" class="hover:text-black transition-all">Visuals</a>
            <a href="/writing" class="hover:text-black transition-all">Writing</a>
            <a href="/renaissance" class="text-black border-b border-black pb-1">Renaissance</a>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </nav>

        <!-- 策展头部 -->
        <header class="mb-10">
            <h1 class="text-3xl font-light tracking-tight mb-4 text-black">Renaissance</h1>
            <!-- 已为你调整为严格的 text-[15px]，行间距收紧 -->
            <p class="text-[15px] font-light tracking-wide text-zinc-900 leading-snug italic max-w-prose mb-4">
                "A developing digital museum dedicated to the interconnected history, humanity, art, and science of the era."
            </p>
            <p class="text-zinc-500 leading-snug font-light text-[15px] max-w-prose">
                This space operates as an interactive map of time. Below is a shifting canvas of interconnected intellectual movements, scientific breakthroughs, and artistic forces that defined the era. Click on any node to expand its history, trace its cross-disciplinary connections, or read deep-dive essays.
            </p>
        </header>

        <!-- 顶层子 Tab 导航 -->
        <div class="flex gap-8 mb-14 border-b border-zinc-100 pb-[10px] text-[13px] uppercase tracking-widest overflow-x-auto whitespace-nowrap scrollbar-hide">
            <button id="show-all" class="text-black font-bold border-b-2 border-black -mb-[10px] pb-2 transition-all shrink-0">Overview</button>
            <button id="show-analysis" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Analysis</button>
            <button id="show-reflections" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Reflections</button>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </div>

        <!-- OVERVIEW 核心内容区 -->
        <div id="overview-section" class="space-y-16">
            
            <!-- 🪐 板块一：顶层长廊滑动的卡片堆叠区 -->
            <section class="space-y-4">
                <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-400 font-mono border-b border-zinc-200 pb-2">Curated Categories</div>
                
                <!-- 横向长廊滚动外壳 -->
                <div class="flex gap-12 overflow-x-auto py-8 px-4 scrollbar-hide snap-x">
                    
                    <!-- 1. People Column (点击横向展开三杰) -->
                    <div class="snap-center shrink-0 w-[240px] transition-all duration-500 ease-in-out" id="people-column">
                        <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono block mb-6">// People</span>
                        
                        <!-- 堆叠与滑动画布一体化容器 -->
                        <div id="people-stack" class="relative h-[220px] w-full cursor-pointer transition-all duration-500">
                            
                            <!-- 卡片 1：达芬奇 (初始在最上层) -->
                            <div class="absolute inset-0 bg-white border border-zinc-300 p-5 rounded shadow-[0_8px_20px_rgba(0,0,0,0.05)] hover:border-black transition-all duration-300 card-node z-30" data-modal="da-vinci-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">1452 — 1519</span>
                                <h3 class="text-sm font-medium text-zinc-900">Leonardo da Vinci</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The High Renaissance Master. Anatomy, machines, and sfumato.</p>
                                <span class="text-[9px] text-zinc-300 italic block mt-4 stack-indicator">Click to expand stack →</span>
                            </div>

                            <!-- 卡片 2：米开朗基罗 (初始在中层) -->
                            <div class="absolute inset-0 bg-white border border-zinc-200 p-5 rounded shadow-[0_4px_12px_rgba(0,0,0,0.03)] transform translate-y-2 -translate-x-1 -rotate-2 transition-all duration-500 card-node z-20" data-modal="michelangelo-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">1475 — 1564</span>
                                <h3 class="text-sm font-medium text-zinc-900">Michelangelo</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The logic of stone. Unleashing divine physiological realism.</p>
                            </div>

                            <!-- 卡片 3：拉斐尔 (初始在底层) -->
                            <div class="absolute inset-0 bg-white border border-zinc-200 p-5 rounded shadow-[0_4px_12px_rgba(0,0,0,0.02)] transform translate-y-4 translate-x-2 rotate-2 transition-all duration-500 card-node z-10" data-modal="raphael-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">1483 — 1520</span>
                                <h3 class="text-sm font-medium text-zinc-900">Raffaello Sanzio</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The harmony of geometry. Perfecting classical spatial grace.</p>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Art Column -->
                    <div class="snap-center shrink-0 w-[240px]">
                        <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono block mb-6">// Art</span>
                        <div class="relative h-[220px] w-full">
                            <div class="absolute inset-0 bg-white border border-zinc-200 p-5 rounded shadow-[0_4px_12px_rgba(0,0,0,0.04)] hover:border-black transition-all cursor-pointer card-node" data-modal="art-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">c. 1503</span>
                                <h3 class="text-sm font-medium text-zinc-900">Mona Lisa</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">Structural gaze and layered glazes.</p>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Philosophy Column -->
                    <div class="snap-center shrink-0 w-[240px]">
                        <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono block mb-6">// Philosophy</span>
                        <div class="relative h-[220px] w-full">
                            <div class="absolute inset-0 bg-white border border-zinc-200 p-5 rounded shadow-[0_4px_12px_rgba(0,0,0,0.04)] hover:border-black transition-all cursor-pointer card-node" data-modal="philosophy-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">15th Century</span>
                                <h3 class="text-sm font-medium text-zinc-900">Humanism</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">The recovery of classical agency.</p>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Science Column -->
                    <div class="snap-center shrink-0 w-[240px]">
                        <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono block mb-6">// Science</span>
                        <div class="relative h-[220px] w-full">
                            <div class="absolute inset-0 bg-white border border-zinc-200 p-5 rounded shadow-[0_4px_12px_rgba(0,0,0,0.04)] hover:border-black transition-all cursor-pointer card-node" data-modal="science-modal">
                                <span class="text-[10px] font-mono text-zinc-400 block mb-1">1415</span>
                                <h3 class="text-sm font-medium text-zinc-900">Linear Perspective</h3>
                                <p class="text-[12px] text-zinc-500 font-light mt-1.5 leading-snug">Mathematical encoding of spaces.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- 🗺️ 板块二：高阶美学·三阶段时间线无边界自由探索地图 -->
            <section class="space-y-4">
                <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-400 font-mono border-b border-zinc-200 pb-2">Infinite Space & Timeline Map</div>
                
                <!-- 精调低饱和度古董象牙灰 #F4F1EA -->
                <div id="map-container" class="w-full h-[450px] overflow-auto scrollbar-hide border border-zinc-200 bg-[#F4F1EA] rounded cursor-grab active:cursor-grabbing select-none relative">
                    <div class="w-[1600px] h-full relative p-12 grid grid-cols-3 gap-0 divide-x divide-zinc-300/30">
                        
                        <!-- 【第一阶段：思想觉醒】 -->
                        <div class="px-8 relative h-full">
                            <div class="absolute top-4 left-8 text-[11px] font-mono tracking-[0.15em] text-zinc-400 uppercase">
                                Phase I: The Awakening (14th C.)
                            </div>
                            <p class="absolute top-10 left-8 text-[11px] italic text-zinc-400 font-light max-w-[240px] leading-snug">
                                Vernacular literature, rediscovery of antiquity, and Dante's foundational vision.
                            </p>
                        </div>

                        <!-- 【第二阶段：鼎盛时期】 -->
                        <div class="px-8 relative h-full">
                            <div class="absolute top-4 left-8 text-[11px] font-mono tracking-[0.15em] text-zinc-400 uppercase">
                                Phase II: The Zenith (15th-16th C.)
                            </div>
                            <p class="absolute top-10 left-8 text-[11px] italic text-zinc-400 font-light max-w-[240px] leading-snug">
                                Geometric integration, Platonic Academies, and the height of fine arts.
                            </p>
                        </div>

                        <!-- 【第三阶段：科学破晓】 -->
                        <div class="px-8 relative h-full">
                            <div class="absolute top-4 left-8 text-[11px] font-mono tracking-[0.15em] text-zinc-400 uppercase">
                                Phase III: The Dawn of Science (17th C.)
                            </div>
                            <p class="absolute top-10 left-8 text-[11px] italic text-zinc-400 font-light max-w-[240px] leading-snug">
                                Dissection of the cosmos, observational mechanisms, and scientific empiricism.
                            </p>
                        </div>

                    </div>
                </div>
            </section>

        </div>

        <!-- 隐藏的内容容器 -->
        <div id="content-container" class="hidden"></div>

        <!-- 🪐 弹窗大卡片容器 -->
        <div id="card-modal" class="fixed inset-0 bg-black/20 backdrop-blur-xs z-50 hidden flex items-center justify-center p-6">
            <div class="bg-white border border-zinc-200 w-full max-w-[480px] rounded-sm shadow-xl max-h-[80vh] flex flex-col overflow-hidden transform scale-95 transition-all duration-300">
                <div class="p-6 border-b border-zinc-100 flex justify-between items-center bg-zinc-50">
                    <span id="modal-meta" class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">Metadata</span>
                    <button id="close-modal" class="text-zinc-400 hover:text-black font-light text-lg transition-colors">&times;</button>
                </div>
                <div class="p-6 overflow-y-auto space-y-6 text-left scrollbar-hide">
                    <h2 id="modal-title" class="text-2xl font-light tracking-tight text-black">Title</h2>
                    <div id="modal-body" class="text-zinc-600 font-light text-[14px] leading-snug space-y-4">
                        <!-- 动态正文 -->
                    </div>
                    <div class="pt-6 border-t border-zinc-100 space-y-3">
                        <span class="text-[11px] uppercase tracking-widest text-zinc-400 font-mono block">Linked Exhibitions & Essays</span>
                        <a id="modal-link" href="#" class="inline-block text-[13px] text-zinc-900 border-b border-black pb-0.5 hover:text-zinc-500 hover:border-zinc-300 transition-all font-light">Read Full Research Essay →</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 页脚 -->
        <footer class="mt-24 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
            L'Uomo Universale
        </footer>
    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. 无边界大地图拖拽
        const canvas = document.getElementById('map-container');
        if (canvas) {
            let isDown = false;
            let startX, startY, scrollLeft, scrollTop;
            canvas.addEventListener('mousedown', (e) => {
                isDown = true;
                canvas.classList.remove('cursor-grab');
                canvas.classList.add('cursor-grabbing');
                startX = e.pageX - canvas.offsetLeft;
                startY = e.pageY - canvas.offsetTop;
                scrollLeft = canvas.scrollLeft;
                scrollTop = canvas.scrollTop;
            });
            canvas.addEventListener('mouseleave', () => isDown = false);
            canvas.addEventListener('mouseup', () => isDown = false);
            canvas.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - canvas.offsetLeft;
                const y = e.pageY - canvas.offsetTop;
                canvas.scrollLeft = scrollLeft - (x - startX) * 1.5;
                canvas.scrollTop = scrollTop - (y - startY) * 1.5;
            });
        }

        // 2. 核心交互：点击一摞卡片横向平铺展开，再次点击查看内容
        const peopleColumn = document.getElementById('people-column');
        const peopleStack = document.getElementById('people-stack');
        let isExpanded = false;

        if (peopleStack) {
            peopleStack.addEventListener('click', (e) => {
                // 如果当前是堆叠状态，触发平铺展开
                if (!isExpanded) {
                    e.stopPropagation(); // 阻止冒泡到具体卡片的 Modal 事件
                    isExpanded = true;
                    
                    // 父容器拉宽，容纳三个并列卡片
                    peopleColumn.style.width = '760px'; 
                    peopleStack.style.display = 'flex';
                    peopleStack.style.gap = '24px';
                    
                    // 移除绝对定位和旋转，变成整齐的横向滑动序列
                    const cards = peopleStack.querySelectorAll('.card-node');
                    cards.forEach((card, index) => {
                        card.style.position = 'relative';
                        card.style.transform = 'none';
                        card.style.shrink = '0';
                        card.style.width = '240px';
                        card.classList.remove('shadow-[0_4px_12px_rgba(0,0,0,0.02)]', 'shadow-[0_4px_12px_rgba(0,0,0,0.03)]');
                        card.classList.add('shadow-[0_8px_20px_rgba(0,0,0,0.05)]');
                    });
                    
                    // 隐藏“点击展开”提示
                    const indicator = peopleStack.querySelector('.stack-indicator');
                    if (indicator) indicator.style.display = 'none';
                }
            });
        }

        // 3. 弹窗数据中心与具体卡片点击
        const modalData = {
            'da-vinci-modal': {
                meta: '1452 — 1519 / Firenze',
                title: 'Leonardo da Vinci',
                body: '<p>A central figure of Phase II. Leonardo approached the natural world not merely as a painter, but as an engineer trying to map its structural logic. His notebooks show a beautiful obsession with breaking down movement, optics, and skeletal geometry.</p>',
                link: '/writing'
            },
            'michelangelo-modal': {
                meta: '1475 — 1564 / Caprese',
                title: 'Michelangelo Buonarroti',
                body: '<p>The logic of stone. Michelangelo believed sculpture was the process of liberating the living figure already trapped inside the marble. His masterworks introduced unprecedented psychological tension and physiological accuracy.</p>',
                link: '/writing'
            },
            'raphael-modal': {
                meta: '1483 — 1520 / Urbino',
                title: 'Raffaello Sanzio',
                body: '<p>The harmony of geometry. Perfecting classical clarity, spatial grace, and humanistic composition. His work in the Vatican Stanze defined the visual syntax of High Renaissance grace.</p>',
                link: '/writing'
            }
        };

        const modal = document.getElementById('card-modal');
        const modalMeta = document.getElementById('modal-meta');
        const modalTitle = document.getElementById('modal-title');
        const modalBody = document.getElementById('modal-body');
        const modalLink = document.getElementById('modal-link');
        const closeModal = document.getElementById('close-modal');

        document.querySelectorAll('.card-node').forEach(card => {
            card.addEventListener('click', (e) => {
                // 只有在展开状态下，或者卡片本来就不是堆叠组时，点击才触发 Modal
                if (card.parentElement.id !== 'people-stack' || isExpanded) {
                    e.stopPropagation();
                    const id = card.getAttribute('data-modal');
                    const data = modalData[id] || {
                        meta: 'Exhibition',
                        title: card.querySelector('h3').innerText,
                        body: '<p>This section is currently under construction. Deep dive text and maps links are coming soon.</p>',
                        link: '#'
                    };
                    
                    modalMeta.innerText = data.meta;
                    modalTitle.innerText = data.title;
                    modalBody.innerHTML = data.body;
                    modalLink.setAttribute('href', data.link);
                    
                    modal.classList.remove('hidden');
                }
            });
        });

        if (modal) {
            closeModal.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
        }
    });
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

    /* 初始未展开状态下的微悬浮交互（抽牌效果） */
    #people-stack:not(.expanded-state):hover div:nth-child(2) {
        transform: translate-y(4px) translate-x(-16px) rotate(-4deg);
    }
    #people-stack:not(.expanded-state):hover div:nth-child(3) {
        transform: translate-y(10px) translate-x(20px) rotate(5deg);
    }
</style>