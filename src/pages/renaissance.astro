---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Renaissance | Jingxuan Li">
    <main class="max-w-[700px] mx-auto px-8 py-12">
        
        <nav id="main-nav" class="flex gap-8 mb-12 text-[12px] uppercase tracking-[0.15em] text-zinc-400 font-medium overflow-x-auto whitespace-nowrap scrollbar-hide scroll-smooth">
            <a href="/" class="hover:text-black transition-all">Home</a>
            <a href="/visuals" class="hover:text-black transition-all">Visuals</a>
            <a href="/writing" class="hover:text-black transition-all">Writing</a>
            <a id="active-nav-item" href="/renaissance" class="text-black border-b border-black pb-1">Renaissance</a>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </nav>

        <header class="mb-10">
            <h1 class="text-3xl font-light tracking-tight mb-4 text-black">Renaissance</h1>
            <p class="text-[15px] font-light tracking-wide text-zinc-900 leading-snug italic max-w-prose mb-4">
                "A developing digital museum dedicated to the interconnected history, humanity, art, and science of the era."
            </p>
            <p class="text-zinc-500 leading-snug font-light text-[15px] max-w-prose">
                This space operates as an interactive map of time. Trace the cross-disciplinary connections and intellectual evolutions across the chronological network below.
            </p>
        </header>

        <section class="space-y-4">
            <div class="flex justify-between items-center border-b border-zinc-200 pb-2">
                <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-400 font-mono">Space & Timeline Map</div>
            </div>
            
            <div class="relative rounded border border-zinc-200 overflow-hidden bg-[#F4F1EA]" id="map-wrapper">
                
                <div class="absolute top-4 left-4 z-30 group select-none">
                    <div class="flex items-center gap-1.5 bg-white/90 backdrop-blur-xs border border-amber-600/30 px-2.5 py-1 rounded shadow-xs text-[10px] font-mono font-bold tracking-widest text-amber-800 cursor-help hover:border-amber-600 transition-all">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
                        CORE: HUMANISM
                    </div>
                    <div class="absolute left-0 top-7 w-[280px] bg-white/90 backdrop-blur-md border border-zinc-200 p-4 rounded shadow-xl opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 z-50 text-left">
                        <h4 class="text-[11px] font-mono uppercase tracking-wider text-amber-800 font-bold mb-1.5">Underlying Code</h4>
                        <p class="text-[12px] text-zinc-800 font-light leading-normal mb-2">• <strong>Human-Centric:</strong> Shifting away from medieval theological absolute dominance, centering on human reason and agency.</p>
                        <p class="text-[12px] text-zinc-800 font-light leading-normal">• <strong>Intellectual Pursuits:</strong> Celebrating human capacity, advocating that mankind should relentlessly pursue worldly knowledge and rational truths.</p>
                    </div>
                </div>

                <div id="map-container" class="w-full h-[620px] overflow-x-auto overflow-y-hidden scrollbar-hide cursor-grab active:cursor-grabbing select-none relative">
                    
                    <div class="w-[1680px] h-full relative p-6 flex flex-col justify-between" id="map-scroll-content">
                        
                        <div id="axis-x-header" class="w-full border-b border-zinc-300 pb-4 grid grid-cols-3 text-center sticky top-0 bg-[#F4F1EA] z-10 pl-[120px]">
                            <div class="border-r border-zinc-300/60 px-4 text-left">
                                <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase I: Early 14th C. — Mid 15th C.</div>
                                <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest leading-normal">Trecento / The Awakening & Core Separation of Theology</div>
                            </div>
                            <div class="border-r border-zinc-300/60 px-4 text-left">
                                <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase II: Mid 15th C. — Late 16th C.</div>
                                <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest leading-normal">High Renaissance / Continental Expansion & Peak Art</div>
                            </div>
                            <div class="px-4 text-left">
                                <div class="text-[11px] font-bold tracking-wider text-zinc-800">Phase III: Late 16th C. — Mid 17th C.</div>
                                <div class="text-[9px] text-zinc-400 font-mono mt-0.5 uppercase tracking-widest leading-normal">Seicento / The Scientific Revolution & Epistemic Shift</div>
                            </div>
                        </div>

                        <div id="lanes-matrix" class="flex-1 grid grid-rows-5 divide-y divide-zinc-300/40 py-4 relative">
                            
                            <div class="relative flex items-center pl-[120px] h-full lane-row">
                                <div class="lane-label absolute left-0 w-[100px] font-mono text-[9px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Masters & Thinkers</div>
                                
                                <div class="absolute left-[140px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="dante">Dante Alighieri</div>
                                <div class="absolute left-[340px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="petrarch">Francesco Petrarca</div>
                                <div class="absolute left-[480px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="boccaccio">Giovanni Boccaccio</div>
                                <div class="absolute left-[920px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="davinci">Leonardo da Vinci</div>
                                <div class="absolute left-[1320px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="galileo">Galileo Galilei</div>
                            </div>

                            <div class="relative flex items-center pl-[120px] h-full lane-row">
                                <div class="lane-label absolute left-0 w-[100px] font-mono text-[9px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Literature</div>
                                
                                <div class="absolute left-[170px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="divine_comedy">Divine Comedy</div>
                                <div class="absolute left-[520px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="decameron_book">The Decameron</div>
                                <div class="absolute left-[1020px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="don_quixote">Don Quixote</div>
                            </div>

                            <div class="relative flex items-center pl-[120px] h-full lane-row">
                                <div class="lane-label absolute left-0 w-[100px] font-mono text-[9px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Art</div>
                                
                                <div class="absolute left-[220px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="giotto_art">Giotto Wall Paintings</div>
                                <div class="absolute left-[980px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="monalisa_art">Mona Lisa</div>
                            </div>

                            <div class="relative flex items-center pl-[120px] h-full lane-row">
                                <div class="lane-label absolute left-0 w-[100px] font-mono text-[9px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Philosophy</div>
                                
                                <div class="absolute left-[380px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="humanism_philo">Emergence of Humanism</div>
                                <div class="absolute left-[880px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="prince_philo">The Prince</div>
                                <div class="absolute left-[1120px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="city_sun">The City of the Sun</div>
                                <div class="absolute left-[1480px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="descartes_philo">Cogito Ergo Sum</div>
                            </div>

                            <div class="relative flex items-center pl-[120px] h-full lane-row">
                                <div class="lane-label absolute left-0 w-[100px] font-mono text-[9px] uppercase tracking-widest text-zinc-400 font-bold border-r border-zinc-200/60 h-8 flex items-center pr-2">Science</div>
                                
                                <div class="absolute left-[780px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="copernicus_science">Heliocentrism</div>
                                <div class="absolute left-[1180px] bg-white border border-zinc-300 px-3 py-1 rounded text-[11px] font-medium cursor-pointer hover:border-black tracking-tight map-node" data-id="bruno_science">Infinite Universe</div>
                            </div>
                        </div>

                        <div id="axis-x-footer" class="w-full border-t border-zinc-300 pt-3 flex sticky bottom-0 bg-[#F4F1EA] z-10 font-mono text-[9px] text-zinc-400 pl-[120px]">
                            <div class="flex-1 flex justify-between pr-4 border-r border-zinc-300/40">
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1300</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1350</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1400</span>
                            </div>
                            <div class="flex-1 flex justify-between px-4 border-r border-zinc-300/40">
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1450</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1500</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1550</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1600</span>
                            </div>
                            <div class="flex-1 flex justify-between pl-4">
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1650</span>
                                <span class="relative before:content-[''] before:absolute before:-top-3 before:left-1/2 before:w-[1px] before:h-1.5 before:bg-zinc-300">1700</span>
                                <span></span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <div id="master-modal" class="fixed inset-0 bg-black/20 backdrop-blur-xs z-50 hidden flex items-center justify-center p-6 transition-all duration-300">
            <div class="bg-white border border-zinc-200 w-full max-w-[460px] rounded shadow-2xl max-h-[85vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-300">
                <div class="p-5 border-b border-zinc-100 flex justify-between items-center bg-zinc-50/50">
                    <span id="modal-years" class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">Timeline</span>
                    <button id="close-modal" class="text-zinc-400 hover:text-black font-light text-xl transition-colors">&times;</button>
                </div>
                <div class="p-6 overflow-y-auto space-y-5 text-left scrollbar-hide">
                    <div>
                        <h2 id="modal-name" class="text-2xl font-light tracking-tight text-black">Name</h2>
                        <p id="modal-role" class="text-[11px] font-mono text-zinc-400 uppercase mt-1 tracking-wider">Role</p>
                        <div id="modal-museum-tag" class="inline-block mt-2 text-[10px] bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded text-zinc-600 font-sans hidden"></div>
                    </div>
                    
                    <div id="modal-artwork-container" class="hidden w-full border border-zinc-200 rounded bg-zinc-50 overflow-hidden mb-4">
                        <img id="modal-artwork-img" src="" alt="Renaissance Masterwork" class="w-full h-auto object-contain block" />
                    </div>

                    <div class="space-y-2 bg-zinc-50 p-4 rounded border border-zinc-100">
                        <div id="modal-highlights" class="text-[13px] text-zinc-700 font-light leading-relaxed space-y-2"></div>
                    </div>

                    <div id="modal-connections-box" class="pt-4 border-t border-zinc-100 space-y-2 hidden">
                        <span class="text-[9px] uppercase tracking-widest text-zinc-400 font-mono block">Connected Nodes</span>
                        <div id="modal-connections-list" class="flex flex-wrap gap-2"></div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-24 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
            L'Uomo Universale
        </footer>
    </main>
</Layout>

<script>
    // Pure Structural Accurate Connection Graph Pool — Cleaned & Hard-Checked
    const itemData = {
        'dante': { category: 'masters', years: '1265 — 1321', name: 'Dante Alighieri', role: 'Poet / Philosopher / Theologian', connections: [{ id: 'divine_comedy', label: 'Divine Comedy' }], highlights: '<p>• A prophetic pioneer of the Renaissance, structuring the monumental bridge between medieval scholasticism and human historical duty.</p><p>• Elevated vernacular language to cosmic dimensions, paving the initial pathway for human intellectual agency.</p>' },
        'divine_comedy': { category: 'literature', years: '1308 — 1321', name: 'Divine Comedy (Divina Commedia)', role: 'Epic Poem / Vernacular Literature', connections: [{ id: 'dante', label: 'Dante Alighieri' }], highlights: '<p>• Abandoned traditional Latin constraints to record cosmic theological and secular designs through local spoken language, rendering divine design accessible to mortal consciousness.</p>' },
        'petrarch': { category: 'masters', years: '1304 — 1374', name: 'Francesco Petrarca', role: 'The Father of Humanism', connections: [{ id: 'humanism_philo', label: 'Emergence of Humanism' }], highlights: '<p>• Championed the essential recovery of classical antiquity and human agency. Posited the critical tension between human studies and divine dogma, asserting that humanity must actively look for secular reason and virtue.</p>' },
        'humanism_philo': { category: 'philosophy', years: '14th — 15th Century', name: 'The Emergence of Humanism', role: 'Philosophical Paradigm Shift', connections: [{ id: 'petrarch', label: 'Francesco Petrarca' }], highlights: '<p>• The elemental atmosphere of the era. Transitioning human thought from a vertical theological geocentrism to Studia Humanitatis (the human disciplines).</p>' },
        'boccaccio': { category: 'masters', years: '1313 — 1375', name: 'Giovanni Boccaccio', role: 'Novelist / Humanist Scholar', connections: [{ id: 'decameron_book', label: 'The Decameron' }], highlights: '<p>• Broke from rigid allegorical medieval frameworks to capture the raw, complex, and distinct psychological textures of everyday secular human experiences.</p>' },
        'decameron_book': { category: 'literature', years: 'c. 1353', name: 'The Decameron', role: 'Prose Masterwork / Library Artifact', connections: [{ id: 'boccaccio', label: 'Giovanni Boccaccio' }], highlights: '<p>• A milestone text tracking human resilience and psychological realism through 100 vivid secular stories told during the Black Death outside Florence.</p>' },
        
        'giotto_art': { category: 'art', years: '1267 — 1337', name: 'Giotto Wall Paintings', role: 'Fresco Cycle', connections: [], highlights: '<p>• Shifted fine arts from rigid medieval symbolism to organic reality. Humanized the divine by bringing real emotions, physical textures, and mortal suffering directly onto religious walls.</p>' },
        
        // 🏛️ The Only Node permitted to hold Location info
        'davinci': { 
            category: 'masters', 
            years: '1452 — 1519', 
            name: 'Leonardo da Vinci', 
            role: 'The Ultimate Polymath', 
            connections: [{ id: 'monalisa_art', label: 'Mona Lisa' }], 
            highlights: '<p>• Erased the false boundary between fine arts and mechanical observation, treating empirical dissection and drawing as structural tools for universal truth.</p>' 
        },
        'monalisa_art': { 
            category: 'art', 
            years: 'c. 1503', 
            name: 'Mona Lisa (La Gioconda)', 
            role: 'Oil on Poplar Panel', 
            artwork: '/renaissance/mona_lisa.jpg', 
            museum: 'Musée du Louvre, Paris', 
            connections: [{ id: 'davinci', label: 'Leonardo da Vinci' }], 
            highlights: '<p>• Built with dozens of microscopic glaze layers (Sfumato) to capture how the human eye actually perceives visual boundaries, light dispersion, and natural atmospheric depth.</p>' 
        },

        'don_quixote': { category: 'literature', years: '1605 — 1615', name: 'Don Quixote', role: 'The First Modern Novel', connections: [], highlights: '<p>• Deconstructs medieval romantic chivalry, utilizing tragicomic irony to explore how human perception collides with a shifting, unromantic world.</p>' },
        'city_sun': { category: 'philosophy', years: '1602', name: 'The City of the Sun', role: 'Utopian Political Treatise', connections: [], highlights: '<p>• An early communist utopian design. Constructs an idealized egalitarian commonwealth rooted entirely in reason, operating without private property or systemic oppression.</p>' },
        'prince_philo': { category: 'philosophy', years: '1513', name: 'The Prince', role: 'Realpolitik Theory', connections: [], highlights: '<p>• Severed political philosophy from metaphysical morality. Offered an empirical, objective anatomy of power mechanics and modern nation-state sovereignty.</p>' },
        
        'copernicus_science': { category: 'science', years: '1543', name: 'Heliocentrism', role: 'De revolutionibus orbium coelestium', connections: [{ id: 'bruno_science', label: 'Infinite Universe' }], highlights: '<p>• Challenged the absolute geocentric model through mathematical and geometric calculation, initiating the modern scientific revolution.</p>' },
        'bruno_science': { category: 'science', years: '1548 — 1600', name: 'Infinite Universe', role: 'Cosmological Thesis', connections: [{ id: 'copernicus_science', label: 'Heliocentrism' }, { id: 'galileo', label: 'Galileo Galilei' }], highlights: '<p>• Defended heliocentrism and proposed an infinite universe with no singular cosmic center. Executed at the stake by the Roman Inquisition for theological defiance.</p>' },
        'galileo': { category: 'masters', years: '1564 — 1642', name: 'Galileo Galilei', role: 'Father of Modern Science', connections: [{ id: 'bruno_science', label: 'Infinite Universe' }], highlights: '<p>• Turned the telescope skyward to prove celestial bodies are physically imperfect objects akin to Earth, breaking the classical Aristotelian paradigm of absolute celestial purity.</p>' },
        'descartes_philo': { category: 'philosophy', years: '1637', name: 'Cogito Ergo Sum', role: 'Rationalist Epistemology', connections: [], highlights: '<p>• Established radical skepticism as the foundation of reason, establishing individual human cognitive awareness as the absolute starting point for all objective truth.</p>' }
    };

    // Desktop Horizontal Mouse Dragging Physics Engine
    const mapContainer = document.getElementById('map-container');
    if (mapContainer) {
        let isDown = false, startX, scrollLeft;
        mapContainer.addEventListener('mousedown', (e) => {
            isDown = true;
            mapContainer.classList.replace('cursor-grab', 'cursor-grabbing');
            startX = e.pageX - mapContainer.offsetLeft;
            scrollLeft = mapContainer.scrollLeft;
        });
        mapContainer.addEventListener('mouseleave', () => isDown = false);
        mapContainer.addEventListener('mouseup', () => { 
            isDown = false; 
            mapContainer.classList.replace('cursor-grabbing', 'cursor-grab'); 
        });
        mapContainer.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            mapContainer.scrollLeft = scrollLeft - (e.pageX - startX) * 1.5;
        });
    }

    // Modal Operations Engine
    const modal = document.getElementById('master-modal');
    const mYears = document.getElementById('modal-years');
    const mName = document.getElementById('modal-name');
    const mRole = document.getElementById('modal-role');
    const mMuseum = document.getElementById('modal-museum-tag');
    const mHighlights = document.getElementById('modal-highlights');
    const artContainer = document.getElementById('modal-artwork-container');
    const artImg = document.getElementById('modal-artwork-img') as HTMLImageElement;
    const connectionsBox = document.getElementById('modal-connections-box');
    const connectionsList = document.getElementById('modal-connections-list');

    // Open Modal and render data dynamically
    function openModal(id) {
        const data = itemData[id];
        if (!data) return;

        if (mYears) mYears.innerText = data.years; 
        if (mName) mName.innerText = data.name; 
        if (mRole) mRole.innerText = data.role; 
        if (mHighlights) mHighlights.innerHTML = data.highlights;

        // 🏛️ CRITICAL HARD LOCK: ONLY 'monalisa_art' can unlock and show the location tag
        if (id === 'monalisa_art' && data.museum && mMuseum) {
            mMuseum.innerText = `🏛️ Current Location: ${data.museum}`;
            mMuseum.classList.remove('hidden');
        } else {
            if (mMuseum) {
                mMuseum.innerText = '';
                mMuseum.classList.add('hidden');
            }
        }

        // Render Full Aspect Ratio Images safely without vertical cuts
        if (data.artwork && artImg && artContainer) { 
            artImg.src = data.artwork; 
            artContainer.classList.remove('hidden'); 
        } else { 
            artContainer?.classList.add('hidden'); 
        }

        // Render Cross-Links
        if (connectionsList && connectionsBox) {
            connectionsList.innerHTML = '';
            if (data.connections && data.connections.length > 0) {
                data.connections.forEach(conn => {
                    const linkBtn = document.createElement('button');
                    linkBtn.className = "text-[11px] bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded text-zinc-900 hover:bg-black hover:text-white hover:border-black transition-all font-light font-sans tracking-tight cursor-pointer";
                    linkBtn.innerText = conn.label;
                    linkBtn.onclick = () => openModal(conn.id);
                    connectionsList.appendChild(linkBtn);
                });
                connectionsBox.classList.remove('hidden');
            } else {
                connectionsBox.classList.add('hidden');
            }
        }

        modal?.classList.remove('hidden');
        setTimeout(() => { 
            modal?.querySelector('.bg-white')?.classList.remove('scale-95', 'opacity-0'); 
        }, 20);
    }

    // Grid Nodes Interactive Click Listener
    document.querySelectorAll('.map-node').forEach(node => {
        node.addEventListener('click', () => {
            const id = node.getAttribute('data-id');
            if (id) openModal(id);
        });
    });

    const closeModalBox = () => {
        modal?.querySelector('.bg-white')?.classList.add('scale-95', 'opacity-0');
        setTimeout(() => modal?.classList.add('hidden'), 150);
    };
    
    document.getElementById('close-modal')?.addEventListener('click', closeModalBox);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModalBox(); });
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    
    .map-node {
        transition: border-color 0.2s, background-color 0.2s;
    }
</style>