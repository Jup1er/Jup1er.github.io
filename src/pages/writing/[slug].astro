---
// src/pages/writing/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Jingxuan Li`}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  </Fragment>

  <article class="w-full">
    <a href="/writing" class="text-[12px] text-zinc-400 hover:text-black transition-colors uppercase tracking-widest mb-6 inline-block">← Back to Writings</a>
    
    <header class="mb-6 border-b border-zinc-100 pb-6">
      <h1 
        class="text-3xl tracking-normal leading-tight mb-3"
        style="
            font-family: 'IBM Plex Sans', sans-serif;
            color: #0f0f0f;
            font-weight: 400;
            -webkit-font-smoothing: antialiased;
        "
      >
        {post.data.title}
      </h1>
      <p class="text-zinc-500 italic font-light text-[14px] leading-relaxed">
        {post.data.description}
      </p>
    </header>

    <div 
        class="prose prose-zinc max-w-none text-[17px] leading-relaxed space-y-6"
        style="
            font-family: 'IBM Plex Sans', sans-serif;
            color: #000000;
            font-weight: 300;
            text-shadow: 0 0 0.5px rgba(0,0,0,0.5);
            line-height: 1.5;
            letter-spacing: -0.01em;
            -webkit-font-smoothing: antialiased; 
            -moz-osx-font-smoothing: grayscale; 
            font-synthesis: none;
        "
    >
      <Content />
    </div>
  </article>
</Layout>
