---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Visual Studies | Jingxuan Li">
	<main class="max-w-[700px] mx-auto px-8 py-12">
		
		<nav class="flex gap-8 mb-12 text-[12px] uppercase tracking-[0.15em] text-zinc-400 font-medium overflow-x-auto whitespace-nowrap scrollbar-hide">
			<a href="/" class="hover:text-black transition-all">Home</a>
			<a href="/visuals" class="text-black border-b border-black pb-1">Visuals</a>
			<a href="/writing" class="hover:text-black transition-all">Writing</a>
			<a href="/renaissance" class="hover:text-black transition-all">Renaissance</a>
			<div class="min-w-[32px] h-1 shrink-0"></div>
		</nav>

		<header class="mb-10">
			<h1 class="text-3xl font-light tracking-tight mb-2 text-black">Visual Archive</h1>
			<p class="text-zinc-500 font-light leading-relaxed text-[15px]">
				A chronological documentation of my journey in learning fine art.
			</p>
		</header>

		<div class="flex gap-8 mb-11 border-b border-zinc-100 pb-[10px] text-[13px] uppercase tracking-widest overflow-x-auto whitespace-nowrap scrollbar-hide">
			<button id="show-all" class="text-black font-bold border-b-2 border-black -mb-[10px] pb-2 transition-all shrink-0">Overview</button>
			<button id="show-selected" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Selected Works</button>
			<button id="show-archive" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Full Archive</button>
			<div class="min-w-[32px] h-1 shrink-0"></div>
		</div>

		<div id="content-container" class="space-y-12">
			
			<div id="selected-section" class="space-y-10 max-w-[600px]">
				<div id="selected-title" class="flex items-center gap-4 mb-4">
					<h2 class="text-[12px] uppercase tracking-[0.3em] text-zinc-900 font-bold">Selected Works</h2>
				</div>

				<section>
					<div class="mb-3 overflow-hidden bg-zinc-50 border border-zinc-100">
						<img src="/apple-full.jpg" alt="Sketch: Apple" class="w-full clickable-img" />
					</div>
					<div class="mb-1">
						<h3 class="text-sm font-medium text-black">Sketch: Apple</h3>
						<p class="text-[10px] text-zinc-400 uppercase tracking-widest">May 02, 2026</p>
					</div>
				</section>

				<section>
					<div class="mb-3 overflow-hidden bg-zinc-50 border border-zinc-100">
						<img src="/geo-full.jpg" alt="Sketch: Plaster" class="w-full clickable-img" />
					</div>
					<div class="mb-1">
						<h3 class="text-sm font-medium text-black">Sketch: Plaster</h3>
						<p class="text-[10px] text-zinc-400 uppercase tracking-widest">May 02, 2026</p>
					</div>
				</section>
			</div>

			<div id="archive-section" class="space-y-6">
				<div id="archive-title" class="flex items-center gap-4 mb-4">
					<h2 class="text-[12px] uppercase tracking-[0.3em] text-zinc-900 font-bold">Monthly Archive</h2>
				</div>

				<section>
					<p class="text-[10px] uppercase tracking-widest text-zinc-400 mb-4 font-semibold">May 2026 →</p>
					<div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
						<div class="flex-none w-44">
							<div class="aspect-square bg-zinc-50 border border-zinc-100 overflow-hidden mb-2">
								<img src="/visual_0526_3.jpg" class="w-full h-full object-cover clickable-img" />
							</div>
						</div>
						<div class="flex-none w-44">
							<div class="aspect-square bg-zinc-50 border border-zinc-100 overflow-hidden mb-2">
								<img src="/visual_0526_2.jpg" class="w-full h-full object-cover clickable-img" />
							</div>
						</div>
						<div class="flex-none w-44">
							<div class="aspect-square bg-zinc-50 border border-zinc-100 overflow-hidden mb-2">
								<img src="/visual_0526_1.jpg" class="w-full h-full object-cover clickable-img" />
							</div>
						</div>
						<div class="min-w-[16px] shrink-0"></div>
					</div>
				</section>

				<section>
					<p class="text-[10px] uppercase tracking-widest text-zinc-400 mb-4 font-semibold">April 2026 →</p>
					<div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0426_5.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0426_4.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0426_3.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0426_2.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0426_1.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="min-w-[16px] shrink-0"></div>
					</div>
				</section>

				<section>
					<p class="text-[10px] uppercase tracking-widest text-zinc-400 mb-4 font-semibold">March 2026 - Commencing Studies →</p>
					<div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0326_4.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0326_3.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0326_2.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="flex-none w-44"><div class="aspect-square border border-zinc-100 mb-2"><img src="/visual_0326_1.jpg" class="w-full h-full object-cover clickable-img" /></div></div>
						<div class="min-w-[16px] shrink-0"></div>
					</div>
				</section>
			</div>

		</div>

		<div id="lightbox" class="fixed inset-0 bg-white/95 z-50 hidden flex items-center justify-center">
			<img id="lightbox-img" src="" class="max-w-[90vw] max-h-[90vh] object-contain shadow-2xl transition-opacity duration-300" />
		</div>

		<footer class="mt-21 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
			Documenting the process of learning
		</footer>
	</main>
</Layout>

<script>
	// 页面刚加载时，自动让主导航栏（顶部那排）居中
	document.addEventListener('DOMContentLoaded', () => {
		const activeNav = document.querySelector('nav a.text-black');
		if (activeNav) {
			activeNav.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
		}
	});

	const btnAll = document.getElementById('show-all');
	const btnSelected = document.getElementById('show-selected');
	const btnArchive = document.getElementById('show-archive');
	
	const selectedSec = document.getElementById('selected-section');
	const archiveSec = document.getElementById('archive-section');
	
	const selectedTitle = document.getElementById('selected-title');
	const archiveTitle = document.getElementById('archive-title');

	function updateTabs(activeBtn) {
		[btnAll, btnSelected, btnArchive].forEach(btn => {
			btn.classList.remove('text-black', 'font-bold', 'border-b-2', 'border-black', '-mb-[10px]');
			btn.classList.add('text-zinc-500');
		});
		activeBtn.classList.add('text-black', 'font-bold', 'border-b-2', 'border-black', '-mb-[10px]');
		activeBtn.classList.remove('text-zinc-500');

		// 核心改动：被点击的子 Tab 自动居中对齐
		activeBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
	}

	btnAll.addEventListener('click', () => {
		selectedSec.style.display = 'block';
		archiveSec.style.display = 'block';
		selectedTitle.style.display = 'flex';
		archiveTitle.style.display = 'flex';
		updateTabs(btnAll);
	});

	btnSelected.addEventListener('click', () => {
		selectedSec.style.display = 'block';
		archiveSec.style.display = 'none';
		selectedTitle.style.display = 'none'; 
		updateTabs(btnSelected);
	});

	btnArchive.addEventListener('click', () => {
		selectedSec.style.display = 'none';
		archiveSec.style.display = 'block';
		archiveTitle.style.display = 'none'; 
		updateTabs(btnArchive);
	});

	// LIGHTBOX 逻辑
	const lightbox = document.getElementById('lightbox');
	const lightboxImg = document.getElementById('lightbox-img');

	document.querySelectorAll('.clickable-img').forEach(img => {
		img.addEventListener('click', () => {
			lightboxImg.src = img.src;
			lightbox.classList.remove('hidden');
			document.body.style.overflow = 'hidden'; 
		});
	});

	lightbox.addEventListener('click', () => {
		lightbox.classList.add('hidden');
		document.body.style.overflow = 'auto'; 
	});
</script>

<style>
	.scrollbar-hide::-webkit-scrollbar { display: none; }
	.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
	.clickable-img { cursor: default; }
</style>