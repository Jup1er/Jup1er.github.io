---
import Layout from '../layouts/Layout.astro';

const selectedWorks = [
    { src: '/visual_0626_5.jpg', title: 'Sketch: Still Life Composition 2', date: 'Jun 20, 2026' },
    { src: '/visual_0626_4.jpg', title: 'Sketch: Still Life Composition', date: 'Jun 14, 2026' },
    { src: '/visual_0526_7.jpg', title: 'Sketch: Medicine Decocting Pot', date: 'May 30, 2026' },
    { src: '/visual_0526_4.jpg', title: 'Sketch: Pear and Tomato', date: 'May 17, 2026' }
];

const archiveMonths = [
    {
        month: 'June 2026',
        images: [
            '/visual_0626_5.jpg', '/visual_0626_4.jpg', '/visual_0626_3.jpg', '/visual_0626_2.jpg', '/visual_0626_1.jpg'
        ]
    },
    {
        month: 'May 2026',
        images: [
            '/visual_0526_7.jpg', '/visual_0526_6.jpg', '/visual_0526_5.jpg',
            '/visual_0526_4.jpg', '/visual_0526_3.jpg', '/visual_0526_2.jpg', '/visual_0526_1.jpg'
        ]
    },
    {
        month: 'April 2026',
        images: [
            '/visual_0426_5.jpg', '/visual_0426_4.jpg', '/visual_0426_3.jpg', '/visual_0426_2.jpg', '/visual_0426_1.jpg'
        ]
    },
    {
        month: 'March 2026 - Commencing Studies',
        images: [
            '/visual_0326_4.jpg', '/visual_0326_3.jpg', '/visual_0326_2.jpg', '/visual_0326_1.jpg'
        ]
    }
];
---

<Layout title="Visual Studies | Jingxuan Li">
    <main class="max-w-[800px] mx-auto px-8 py-12">
        
        <nav id="main-nav" class="flex gap-8 mb-10 text-[12px] uppercase tracking-[0.15em] text-zinc-400 font-medium overflow-x-auto whitespace-nowrap scrollbar-hide scroll-smooth">
            <a href="/" class="hover:text-black transition-all">About</a>
            <a id="active-nav-item" href="/visuals" class="text-black border-b border-black pb-1">Visuals</a>
            <a href="/writing" class="hover:text-black transition-all">Writing</a>
            <a href="/renaissance" class="hover:text-black transition-all">Renaissance</a>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </nav>

        <header class="mb-10">
            <h1 class="text-3xl font-light tracking-tight mb-2 text-black">Visual Archive</h1>
            <p class="text-zinc-500 font-light leading-relaxed text-[15px]">
                A chronological documentation of my journey in learning fine art.
            </p>
        </header>

        <div class="flex gap-8 mb-11 border-b border-zinc-100 pb-[10px] text-[13px] uppercase tracking-widest overflow-x-auto whitespace-nowrap scrollbar-hide">
            <button id="show-selected" class="text-black font-bold border-b-2 border-black -mb-[10px] pb-2 transition-all shrink-0">Selected Works</button>
            <button id="show-archive" class="text-zinc-500 hover:text-black transition-all pb-2 shrink-0">Monthly Archive</button>
            <div class="min-w-[32px] h-1 shrink-0"></div>
        </div>

        <div id="content-container" class="space-y-12">
            
            <!-- 🌟 核心修改：Grid 响应式网格布局，手机 1 列，电脑 2 列 -->
            <div id="selected-section" class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
                {selectedWorks.map(work => (
                    <section>
                        <!-- 使用 aspect-[4/3] 保证并排时图片高度完全一致，裁切完美 -->
                        <div class="mb-3 overflow-hidden bg-zinc-50 border border-zinc-100 rounded-sm aspect-[4/3]">
                            <img src={work.src} alt={work.title} class="w-full h-full object-cover cursor-zoom-in clickable-img" />
                        </div>
                        <div class="mb-1">
                            <h3 class="text-sm font-medium text-black">{work.title}</h3>
                            <p class="text-[10px] text-zinc-400 uppercase tracking-widest mt-0.5">{work.date}</p>
                        </div>
                    </section>
                ))}
            </div>

            <!-- 月度归档区域（保持横滑不变） -->
            <div id="archive-section" class="space-y-8" style="display: none;">
                {archiveMonths.map(section => (
                    <section class="archive-row-container">
                        <p class="text-[10px] uppercase tracking-widest text-zinc-400 mb-3 font-semibold">{section.month} →</p>
                        
                        <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide cursor-grab active:cursor-grabbing select-none archive-scroll-canvas">
                            {section.images.map(imgSrc => (
                                <div class="flex-none w-44">
                                    <div class="aspect-square bg-zinc-50 border border-zinc-100 overflow-hidden mb-2 rounded-sm">
                                        <img src={imgSrc} class="w-full h-full object-cover clickable-img" />
                                    </div>
                                </div>
                            ))}
                            <div class="min-w-[16px] shrink-0"></div>
                        </div>
                    </section>
                ))}
            </div>

        </div>

        <!-- 极简灯箱 -->
        <div id="lightbox" class="fixed inset-0 bg-white/95 backdrop-blur-xs z-50 hidden flex items-center justify-center p-6 cursor-zoom-out">
            <img id="lightbox-img" src="" class="max-w-[90vw] max-h-[90vh] object-contain shadow-2xl transition-all duration-300 transform scale-95 opacity-0" />
        </div>

        <footer class="mt-24 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
            Documenting the process of learning
        </footer>
    </main>
</Layout>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const activeNav = document.getElementById('active-nav-item');
        const mainNav = document.getElementById('main-nav');
        if (activeNav && mainNav) {
            mainNav.scrollLeft = activeNav.offsetLeft - (mainNav.offsetWidth / 2) + (activeNav.offsetWidth / 2);
        }
    });

    const btnSelected = document.getElementById('show-selected');
    const btnArchive = document.getElementById('show-archive');
    const selectedSec = document.getElementById('selected-section');
    const archiveSec = document.getElementById('archive-section');

    function updateTabs(activeBtn) {
        [btnSelected, btnArchive].forEach(btn => {
            if (btn) btn.className = 'text-zinc-500 hover:text-black transition-all pb-2 shrink-0';
        });
        if (activeBtn) activeBtn.className = 'text-black font-bold border-b-2 border-black -mb-[10px] pb-2 transition-all shrink-0';
    }

    if (btnSelected && btnArchive) {
        btnSelected.addEventListener('click', () => {
            if (selectedSec) selectedSec.style.display = 'grid'; // Grid 布局恢复时必须用 grid
            if (archiveSec) archiveSec.style.display = 'none';
            updateTabs(btnSelected);
        });

        btnArchive.addEventListener('click', () => {
            if (selectedSec) selectedSec.style.display = 'none';
            if (archiveSec) archiveSec.style.display = 'block';
            updateTabs(btnArchive);
        });
    }

    document.querySelectorAll('.archive-scroll-canvas').forEach(canvas => {
        let isDown = false, startX, scrollLeft;
        let dragThreshold = false; 

        canvas.addEventListener('mousedown', (e: MouseEvent) => {
            isDown = true;
            dragThreshold = false;
            canvas.classList.replace('cursor-grab', 'cursor-grabbing');
            startX = e.pageX - canvas.offsetLeft;
            scrollLeft = canvas.scrollLeft;
        });

        canvas.addEventListener('mouseleave', () => { isDown = false; canvas.classList.replace('cursor-grabbing', 'cursor-grab'); });
        canvas.addEventListener('mouseup', () => { isDown = false; canvas.classList.replace('cursor-grabbing', 'cursor-grab'); });

        canvas.addEventListener('mousemove', (e: MouseEvent) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - canvas.offsetLeft;
            const walk = (x - startX) * 1.5;
            canvas.scrollLeft = scrollLeft - walk;
            
            if (Math.abs(walk) > 5) {
                dragThreshold = true;
            }
        });

        canvas.addEventListener('click', (e) => {
            if (dragThreshold) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    });

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

    document.querySelectorAll('.clickable-img').forEach(img => {
        img.addEventListener('click', (e) => {
            const canvas = img.closest('.archive-scroll-canvas');
            if (canvas && canvas.classList.contains('cursor-grabbing')) return;

            if (lightbox && lightboxImg) {
                lightboxImg.src = (img as HTMLImageElement).src;
                lightbox.classList.remove('hidden');
                document.body.style.overflow = 'hidden'; 
                
                setTimeout(() => {
                    lightboxImg.classList.remove('scale-95', 'opacity-0');
                }, 10);
            }
        });
    });

    if (lightbox && lightboxImg) {
        lightbox.addEventListener('click', () => {
            lightboxImg.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                document.body.style.overflow = 'auto'; 
            }, 150);
        });
    }
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>