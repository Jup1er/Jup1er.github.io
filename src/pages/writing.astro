---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Writing | Jingxuan Li">
	<main class="max-w-2xl mx-auto px-6 py-20 font-sans text-gray-800">
		<nav class="flex gap-6 mb-16 text-sm uppercase tracking-widest text-gray-400">
			<a href="/" class="hover:text-gray-600 transition-colors">Home</a>
			<a href="/visuals" class="hover:text-gray-600 transition-colors">Visuals</a>
			<a href="/writing" class="text-gray-900 font-bold">Writing</a>
			<a href="/renaissance" class="hover:text-gray-600 transition-colors">Renaissance</a>
		</nav>

		<header class="mb-12">
			<h1 class="text-3xl font-light mb-4">Writing (Template)</h1>
			<p class="text-gray-600 leading-relaxed">
				A collection of my philosophical inquiries and research papers, exploring the intersection of technology, sensory perception, and human creativity.
			</p>
		</header>

		<section class="space-y-12">
			<!-- Example Article Entry -->
			<article class="group">
				<div class="flex justify-between items-baseline mb-2">
					<h2 class="text-lg font-medium group-hover:text-blue-700 transition-colors">
						<a href="/papers/information-breadth-vs-depth.pdf" target="_blank">
							The Trade-off Between Information Breadth and Cognitive Depth
						</a>
					</h2>
					<span class="text-xs text-gray-400 font-mono">PDF</span>
				</div>
				<p class="text-sm text-gray-500 leading-relaxed">
					An analysis of how information overload impacts human creativity and the depth of cognitive processing in the digital age.
				</p>
			</article>

			<!-- Placeholder for future articles -->
			<article class="pt-8 border-t border-gray-50 italic text-gray-400 text-sm">
				More articles forthcoming as my graduate research at Western University progresses.
			</article>
		</section>
	</main>
</Layout>