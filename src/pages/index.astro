---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jingxuan Li | About">
    <header class="mb-16">
        <div class="mb-10 w-20 h-20 bg-zinc-100 rounded-full overflow-hidden border border-zinc-100">
            <img src="/me.jpg" alt="Jingxuan Li" class="w-full h-full object-cover" onerror="this.style.display='none'"/>
        </div>
        
        <h1 class="text-4xl font-light tracking-tight mb-8 text-black">Jingxuan Li</h1>
        
        <div class="space-y-6 text-zinc-800 leading-relaxed font-light text-[15px] w-full">
            <p>
                I hold a B.Eng. in Electrical Engineering from McGill University and am currently an MA student in Philosophy at Western University. My academic interests increasingly focus on integrating philosophical and technological perspectives in the study of human perception and cognition.
            </p>
            <p>
                Alongside my academic work, I practice classical drawing and painting and write essays and reflections. I am also drawn to the Renaissance ideal of integrating scientific, humanistic, and artistic ways of understanding the world.
            </p>
            <p>
                This website brings together my academic work, visual work, and broader intellectual projects.
            </p>
        </div>

        <section class="mt-10">
            <div class="flex items-center gap-4 mb-7">
                <h2 class="text-[14px] uppercase tracking-[0.4em] text-black font-bold">Research Interests</h2>
                <div class="h-[1px] flex-1 bg-zinc-100"></div>
            </div>

            <div class="space-y-6 text-zinc-800 leading-relaxed font-light text-[15px] w-full">
                <p>
                    I am interested in how technology can expand or transform human perceptual and cognitive capacities. I am currently approaching this question through sensory and perceptual augmentation, particularly by examining the distinction between learning to use novel sensory information and undergoing a genuine change in perception.
                </p>
                <p>
                    More broadly, I am interested in interdisciplinary research that integrates philosophical analysis with empirical and technical approaches to perception and cognition, including embodied and ecological perspectives on human–technology-environment interaction.
                </p>
            </div>
        </section>

        <div class="mt-10 space-y-6">
            <p class="pt-4 text-[14px] text-zinc-400 italic font-light leading-relaxed border-t border-zinc-100">
                You can look through my <a href="/visuals" class="text-zinc-600 hover:text-black underline underline-offset-4 transition-colors">Art Studies</a> to see my drawing and painting process, read my academic papers and personal essays in <a href="/writing" class="text-zinc-600 hover:text-black underline underline-offset-4 transition-colors">Writing</a>, or explore <a href="/renaissance" class="text-zinc-600 hover:text-black underline underline-offset-4 transition-colors">Renaissance</a> — a developing digital museum dedicated to the interconnected history, humanity, art, and science of the era.
            </p>

            <span class="block text-[13px] text-zinc-400 font-mono italic leading-none">
                Site launched: May 2026 — Last updated: August 2026.
            </span>
        </div>
    </header>

    <!-- 🌟 核心修改：用 Grid 将 Chronology 和 Contact 包裹起来 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 mb-16">
        
        <!-- 左列：Chronology -->
        <section>
            <div class="flex items-center gap-4 mb-7">
                <h2 class="text-[14px] uppercase tracking-[0.4em] text-black font-bold">Chronology</h2>
                <div class="h-[1px] flex-1 bg-zinc-100"></div>
            </div>

            <div class="space-y-5">
                <div>
                    <p class="text-[13px] text-zinc-500 font-mono mb-0.5">September 2026 — August 2027</p>
                    <h3 class="text-sm font-medium text-black leading-tight">MA in Philosophy</h3>
                    <p class="text-xs text-zinc-500 font-light text-[13px]">Western University, London, ON</p>
                </div>
                <div>
                    <p class="text-[13px] text-zinc-500 font-mono mb-0.5">September 2022 — December 2025</p>
                    <h3 class="text-sm font-medium text-black leading-tight">B.Eng. in Electrical Engineering</h3>
                    <p class="text-xs text-zinc-500 font-light text-[13px]">McGill University, Montreal, QC</p>
                </div>
                <div>
                    <p class="text-[13px] text-zinc-500 font-mono mb-0.5">2014</p>
                    <h3 class="text-sm font-medium text-black leading-tight">Relocated to Montreal, Canada</h3>
                    <p class="text-xs text-zinc-500 font-light text-[13px]">From Tianjin, China</p>
                </div>
            </div>
        </section>

        <!-- 右列：Contact -->
        <section>
            <div class="flex items-center gap-4 mb-7">
                <h2 class="text-[14px] uppercase tracking-[0.4em] text-black font-bold">Contact</h2>
                <div class="h-[1px] flex-1 bg-zinc-100"></div>
            </div>

            <div class="flex flex-col gap-3 text-[14px] font-light text-zinc-700">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-zinc-400 inline-block w-14">Email</span>
                    <a href="mailto:jing.x.li@mail.mcgill.ca" class="text-zinc-800 hover:text-black border-b border-zinc-100 hover:border-black transition-all pb-0.5 font-mono">
                        jli5346@uwo.ca
                    </a>
                </div>
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-zinc-400 inline-block w-14">IG</span>
                    <a href="https://instagram.com/jupier418_" target="_blank" class="text-zinc-800 hover:text-black border-b border-zinc-100 hover:border-black transition-all pb-0.5 font-mono">
                        jupier418_
                    </a>
                </div>
            </div>
        </section>

    </div>

    <footer class="mt-24 pb-6 text-[12px] uppercase tracking-widest text-zinc-300 italic text-center">
        Understanding the world through diverse perspectives
    </footer>
</Layout>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const activeNav = document.getElementById('active-nav-item');
        const mainNav = document.getElementById('main-nav');
        if (activeNav && mainNav) {
            mainNav.scrollLeft = activeNav.offsetLeft - (mainNav.offsetWidth / 2) + (activeNav.offsetWidth / 2);
        }
    });
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
